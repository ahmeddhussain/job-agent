{
  "name": "job-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Daily read-only job-hunting agent: collect, dedupe, score, tailor a one-page CV and cover letter, draft the application, track it.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "agent": "dist/cli.js"
  },
  "scripts": {
    "agent": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@googleapis/gmail": "22.1.0",
    "better-sqlite3": "13.2.0",
    "commander": "15.1.0",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.4",
    "handlebars": "4.7.10",
    "html-to-text": "10.0.1",
    "pino": "10.4.0",
    "puppeteer": "24.38.0",
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.8",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "basic-ftp": "6.2.6"
  }
}
