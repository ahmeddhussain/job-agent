# Personal data and secrets: never committed (docs/privacy-security.md).
# Everything a user owns lives in their profile folder; only the fictional example is shared.
profiles/*
!profiles/example/
profiles/example/data/
profiles/example/output/
profiles/example/secrets/
profiles/example/.env
profiles/example/.review-pending

# The old single-user layout (before profiles, D45), in case a checkout still has it
.env
.env.*
secrets/
data/
output/
backups/
config/config.yaml
config/companies.yaml
config/titles.yaml
profile/

# Node / build
node_modules/
dist/
coverage/
*.tsbuildinfo
npm-debug.log*

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
.secrets-blocklist

# Backups written by settings edits and one-time conversions (they hold private values)
*.bak
*.bak-*
*.pre-*
