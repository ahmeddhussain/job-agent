# Copy to .env (gitignored, chmod 600). Never commit real values.
# Claude subscription token from `claude setup-token` (one year). Used only by the
# official `claude` CLI; never copy it into other tools.
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME
# Do NOT set ANTHROPIC_API_KEY: in `claude -p` mode it overrides the subscription
# and bills API credits. The agent refuses to run if it is set.
CONFIG_PATH=config/config.yaml
LOG_LEVEL=info
DASHBOARD_PORT=8080
