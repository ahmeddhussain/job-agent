{
  "manifest_version": 3,
  "name": "Job Agent form filler",
  "version": "1.0.0",
  "description": "Fills the application form you are on from your own job agent. Never submits.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fill this form (Job Agent)",
    "default_popup": "popup.html"
  }
}
